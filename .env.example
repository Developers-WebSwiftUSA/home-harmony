# =============================================================================
# Home Harmony — one place for connection strings and URLs
# =============================================================================
# 1. Copy this file to the SAME folder (repo root) and name it:  .env
# 2. Edit .env — backend and both Vite frontends read from here in development.
#
#    PowerShell:  Copy-Item .env.example .env
#    bash:        cp .env.example .env
#
# Production: set the same variable names in your host (e.g. Render).
# Values are not read from this file on the server unless you deploy a .env
# (usually you inject env vars in the dashboard).
#
# Render (single Web Service + MongoDB Atlas): see DEPLOYMENT.md and render.yaml.
# =============================================================================

# --- MongoDB (backend) ---
MONGODB_URI=mongodb://127.0.0.1:27017/real-estate-platform

# --- API server (backend) ---
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d

# --- Frontend URL (backend CORS / links) ---
# Vite dev (frontend on 8080): keep 8080. Express serves SPA (`npm run serve`): use PORT (5000).
FRONTEND_URL=http://localhost:8080
# On Render, optional if you use the same URL as the Web Service; CORS also allows RENDER_EXTERNAL_URL.

# --- Frontend → backend API (Vite: must be prefixed with VITE_) ---
# Split dev (Vite + API): full URL to the API port
VITE_API_URL=http://localhost:5000/api
# Production on Render (Express serves frontend/dist, same host): use relative API base
# VITE_API_URL=/api
# FRONTEND_URL=https://your-service.onrender.com

# --- Email (optional, backend) ---
# EMAIL_FROM=noreply@example.com
# SENDGRID_API_KEY=
# ETHEREAL_USER=
# ETHEREAL_PASS=

# --- SMS (optional, backend) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
